{
    "name": "franc014/phi-cms-core",
    "description": "Filament-based CMS, Core Package",
    "keywords": [
        "franc014",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "phi-cms-core"
    ],
    "homepage": "https://github.com/franc014/phi-cms-core",
    "support": {
        "issues": "https://github.com/franc014/phi-cms-core/issues",
        "source": "https://github.com/franc014/phi-cms-core"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Francisco Andrade",
            "email": "jfandradea@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "spatie/eloquent-sortable": "^4.0|^5.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/laravel-settings": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26",
        "spatie/laravel-tags": "^4.2"
    },
    "autoload": {
        "psr-4": {
            "JFA\\PhiCmsCore\\": "src/",
            "JFA\\PhiCmsCore\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JFA\\PhiCmsCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JFA\\PhiCmsCore\\PhiCmsCoreServiceProvider"
            ],
            "aliases": {
                "PhiCmsCore": "JFA\\PhiCmsCore\\Facades\\PhiCmsCore"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
